{
  "name": "@eq-labs/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard application for the EQ-LABS Engineering Ecosystem.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eq-labs/config-eslint": "workspace:*",
    "@eq-labs/config-playwright": "workspace:*",
    "@eq-labs/config-typescript": "workspace:*",
    "@eq-labs/config-vite": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
