{
  "name": "@eq-labs/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard application for the EQ-LABS Engineering Ecosystem.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "preview": "vite preview",
    "test:e2e": "node ./scripts/run-e2e.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eq-labs/config-eslint": "workspace:*",
    "@eq-labs/config-playwright": "workspace:*",
    "@eq-labs/config-typescript": "workspace:*",
    "@eq-labs/config-vite": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
