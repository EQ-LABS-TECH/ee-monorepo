    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@eq-labs/foundation": "workspace:*"
  },
  "devDependencies": {
    "@eq-labs/config-vitest": "workspace:*",
    "@eq-labs/config-eslint": "workspace:*",
    "@eq-labs/config-typescript": "workspace:*",
    "eslint": "9.35.0",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
