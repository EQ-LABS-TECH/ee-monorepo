{
  "name": "@eq-labs/intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligence layer of the EQ-LABS Engineering Ecosystem.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
