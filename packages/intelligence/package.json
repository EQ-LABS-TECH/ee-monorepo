    "lint": "eslint ."
  },
  "dependencies": {
    "@eq-labs/foundation": "workspace:*"
  },
  "devDependencies": {
    "@eq-labs/config-eslint": "workspace:*",
    "@eq-labs/config-typescript": "workspace:*",
    "@types/node": "22.18.6",
    "eslint": "9.35.0",
    "typescript": "5.9.2"
  }
