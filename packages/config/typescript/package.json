{
  "name": "@eq-labs/config-typescript",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": [
    "base.json",
    "node.json",
    "react.json",
    "README.md",
    "package.json"
  ],
  "exports": {
    "./base": "./base.json",
    "./node": "./node.json",
    "./react": "./react.json"
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs'); ['base.json','node.json','react.json'].forEach(f=>{if(!fs.existsSync(f))throw new Error('Missing '+f)}); console.log('Build successful')\"",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "9.35.0",
    "@eq-labs/config-eslint": "workspace:*"
  }
}
