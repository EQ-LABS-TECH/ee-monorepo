#!/usr/bin/env node
import { spawnSync } from "node:child_process";

console.log("🏗️ Building all workspaces (QG-BUILD-001)...");
console.log("");

const result = spawnSync("pnpm", ["exec", "turbo", "run", "build"], {
  stdio: "inherit",
  shell: process.platform === "win32",
  cwd: process.cwd(),
});

if (result.status !== 0) {
  console.error("");
  console.error("❌ QG-BUILD-001: FAIL");
  process.exit(result.status ?? 1);
}

console.log("");
console.log("✅ QG-BUILD-001: PASS");
