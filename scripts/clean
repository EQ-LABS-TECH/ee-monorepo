#!/usr/bin/env node

import { spawnSync } from "node:child_process";

console.log("🧹 Cleaning EE-LABS Monorepo...");
console.log("");

const result = spawnSync("turbo", ["run", "clean"], {
  stdio: "inherit",
  shell: true,
});

if (result.status !== 0) {
  console.error("");
  console.error("❌ Clean failed");
  process.exit(result.status ?? 1);
}

console.log("");
console.log("✅ Clean completed successfully!");
