#!/usr/bin/env node

import { spawnSync } from 'node:child_process';

const args = ['exec', 'turbo', 'run', 'test:e2e', '--filter=@eq-labs/dashboard'];

const result = spawnSync('pnpm', args, {
  stdio: 'inherit',
  shell: process.platform === 'win32',
});

if (result.error) {
  console.error(`❌ Unable to start the E2E task: ${result.error.message}`);
  process.exit(1);
}

process.exit(result.status ?? 1);
