#!/usr/bin/env node

import { spawnSync } from 'node:child_process';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { parse } from 'yaml';
import { runSecurityAuditWithWaivers } from '../lib/security-audit.mjs';
import { validateTemplates } from '../lib/validate-templates.mjs';
import { validateGateContract } from '../lib/validate-gate-contract.mjs';
import { aggregateGateResults } from '../lib/aggregate-gate-results.mjs';
import { validateRepositoryStructure } from '../lib/repository-structure.mjs';

const ROOT = process.cwd();

function execCommand(cmd, args, label, { requireGateContract = false, expectedGateId } = {}) {
  console.log(`  ${label}...`);

  const result = spawnSync(cmd, args, {
    encoding: 'utf-8',
    shell: process.platform === 'win32',
    cwd: ROOT,
  });

  const stdout = result.stdout ?? '';
  const stderr = result.stderr ?? '';

  if (stdout) process.stdout.write(stdout);
  if (stderr) process.stderr.write(stderr);

  if (result.error) {
    console.error(`  ❌ ${label} could not start: ${result.error.message}`);
    return {
      status: 'ERROR',
      exitCode: 1,
      detail: result.error.message,
    };
  }

  if (requireGateContract) {
    return validateGateContract({
      stdout,
      processExitCode: result.status,
      expectedGateId,
    });
  }

  if (result.status === 0) {
    return { status: 'PASS', exitCode: 0 };
  }

  return {
    status: 'FAIL',
    exitCode: result.status ?? 1,
  };
}

function validateWorkspace() {
  const errors = [];

  const workspacePath = join(ROOT, 'pnpm-workspace.yaml');

  if (!existsSync(workspacePath)) {
    errors.push('Missing pnpm-workspace.yaml');

    return errors;
  }

  try {
    const content = readFileSync(workspacePath, 'utf-8');

    const workspace = parse(content);

    if (!workspace || typeof workspace !== 'object' || Array.isArray(workspace)) {
      errors.push('pnpm-workspace.yaml does not contain a valid YAML object');

      return errors;
    }

    if (!Array.isArray(workspace.packages)) {
      errors.push('pnpm-workspace.yaml must define packages as an array');

      return errors;
    }

    const requiredPatterns = [
      'apps/*',
      'apps/extensions/*',
      'connectors/official/*',
      'packages/config/*',
      'packages/foundation',
      'packages/shared',
      'packages/execution',
      'packages/intelligence',
      'packages/knowledge',
      'packages/governance',
      'packages/integration',
      'packages/registry',
      'packages/sdk',
    ];

    for (const pattern of requiredPatterns) {
      if (!workspace.packages.includes(pattern)) {
        errors.push(`pnpm-workspace.yaml missing workspace pattern: ${pattern}`);
      }
    }
  } catch (error) {
    errors.push(
      `Could not parse pnpm-workspace.yaml: ${
        error instanceof Error ? error.message : String(error)
      }`,
    );
  }

  return errors;
}

function validateDocumentation() {
  const errors = [];
  const requiredFiles = ['README.md', 'LICENSE', 'NOTICE', 'CHANGELOG.md'];

  for (const file of requiredFiles) {
    if (!existsSync(join(ROOT, file))) {
      errors.push(`QG-DOC-001: missing required file: ${file}`);
    }
  }

  try {
    const pkg = JSON.parse(readFileSync(join(ROOT, 'package.json'), 'utf-8'));
    if (!pkg.name) {
      errors.push('QG-DOC-002: package.json missing name');
    }
    if (!pkg.engines?.node) {
      errors.push('QG-DOC-002: package.json missing engines.node');
    }

    const nvmPath = join(ROOT, '.nvmrc');
    if (!existsSync(nvmPath)) {
      errors.push('QG-DOC-002: missing .nvmrc');
    } else {
      const nvm = readFileSync(nvmPath, 'utf-8').trim();
      if (!nvm) {
        errors.push('QG-DOC-002: .nvmrc is empty');
      } else if (pkg.engines?.node) {
        const major = nvm.split('.')[0];
        if (!pkg.engines.node.includes(major)) {
          errors.push(
            `QG-DOC-002: engines.node (${pkg.engines.node}) does not align with .nvmrc (${nvm})`,
          );
        }
      }
    }
  } catch (error) {
    errors.push(
      `QG-DOC-002: cannot validate package metadata: ${
        error instanceof Error ? error.message : String(error)
      }`,
    );
  }

  return errors;
}

function validateInfra() {
  const errors = [];
  const required = [
    'infra/containers',
    'infra/orchestration',
    'infra/secrets',
    'infra/secrets/.gitignore',
  ];

  for (const path of required) {
    if (!existsSync(join(ROOT, path))) {
      errors.push(`QG-INFRA-001: missing required path: ${path}`);
    }
  }

  return errors;
}

console.log('🔬 Running full validation suite...');

console.log('');

const validations = [
  {
    cmd: 'node',
    args: ['scripts/commands/validate-names'],
    label: 'Repository naming',
    critical: true,
    requireGateContract: true,
    expectedGateId: 'QG-NAM-001',
  },
  {
    cmd: 'node',
    args: ['scripts/commands/validate-branch'],
    label: 'Branch name',
    critical: true,
    requireGateContract: true,
    expectedGateId: 'QG-BRANCH-001',
  },
  {
    cmd: 'node',
    args: ['scripts/commands/validate-commit'],
    label: 'Commit messages',
    critical: true,
    requireGateContract: true,
    expectedGateId: 'QG-COMMIT-001',
  },
  {
    cmd: 'node',
    args: ['scripts/commands/validate-architecture'],
    label: 'Architecture dependencies',
    critical: true,
    requireGateContract: true,
    expectedGateId: 'QG-ARCH-001',
  },
  {
    cmd: 'node',
    args: ['scripts/commands/typecheck'],
    label: 'Type checking',
    critical: true,
    requireGateContract: true,
    expectedGateId: 'QG-TYPE-001',
  },
  {
    cmd: 'node',
    args: ['scripts/commands/lint'],
    label: 'Linting',
    critical: true,
    requireGateContract: true,
    expectedGateId: 'QG-LINT-001',
  },
  {
    cmd: 'node',
    args: ['scripts/commands/test'],
    label: 'Tests',
    critical: true,
    requireGateContract: true,
    expectedGateId: 'QG-TEST-001',
  },
  {
    cmd: 'node',
    args: ['scripts/commands/e2e'],
    label: 'E2E Tests',
    critical: true,
    requireGateContract: true,
    expectedGateId: 'QG-TEST-E2E',
  },
  {
    cmd: 'node',
    args: ['scripts/lib/run-script-tests.mjs'],
    label: 'Script tests',
    critical: true,
    requireGateContract: true,
    expectedGateId: 'QG-SCRIPTS-001',
  },
  {
    cmd: 'node',
    args: ['scripts/commands/build'],
    label: 'Build',
    critical: true,
    requireGateContract: true,
    expectedGateId: 'QG-BUILD-001',
  },
  {
    cmd: 'pnpm',
    args: ['exec', 'prettier', '--check', '.'],
    label: 'Format check',
    critical: true,
  },
];

const gateResults = [];

for (const validation of validations) {
  const result = execCommand(validation.cmd, validation.args, validation.label, {
    requireGateContract: validation.requireGateContract ?? false,
    expectedGateId: validation.expectedGateId,
  });

  gateResults.push({
    gate: validation.label,
    status: result.status,
    exitCode: result.exitCode,
  });

  console.log('');
}

const { hasErrors: gateErrors, warnings } = aggregateGateResults(validations, gateResults);
let hasErrors = gateErrors;

// Security audit con soporte para waivers
const securityResult = runSecurityAuditWithWaivers({ root: ROOT, spawnSyncImpl: spawnSync });
if (!securityResult.ok) {
  hasErrors = true;
}
console.log('');

console.log('  Checking project structure...');
const structureErrors = validateRepositoryStructure({ root: ROOT });
if (structureErrors.length > 0) {
  hasErrors = true;
  structureErrors.forEach((error) => {
    console.error(`    ❌ ${error}`);
  });
}
console.log('');

console.log('  Checking workspace configuration...');
const workspaceErrors = validateWorkspace();
if (workspaceErrors.length > 0) {
  hasErrors = true;
  workspaceErrors.forEach((error) => {
    console.error(`    ❌ ${error}`);
  });
}
console.log('');

console.log('  Checking documentation gates (QG-DOC-001/002)...');
const docErrors = validateDocumentation();
if (docErrors.length > 0) {
  hasErrors = true;
  docErrors.forEach((error) => {
    console.error(`    ❌ ${error}`);
  });
}
console.log('');

console.log('  Checking infrastructure gates (QG-INFRA-001)...');
const infraErrors = validateInfra();
if (infraErrors.length > 0) {
  hasErrors = true;
  infraErrors.forEach((error) => {
    console.error(`    ❌ ${error}`);
  });
}
console.log('');

console.log('  Checking templates gates (QG-REPO-001)...');
const { errors: templateErrors, warnings: templateWarnings } = validateTemplates({ root: ROOT });
if (templateErrors.length > 0) {
  hasErrors = true;
  templateErrors.forEach((error) => {
    console.error(`    ❌ ${error}`);
  });
}
for (const warning of templateWarnings) {
  warnings.push(`⚠️ ${warning}`);
}
console.log('');

console.log('📊 Validation Summary:');

console.log('Gate results:');

for (const result of gateResults) {
  const icon = result.status === 'PASS' ? '✅' : '❌';
  console.log(`  ${icon} ${result.gate}: ${result.status} (exit ${result.exitCode})`);
}

console.log('');

console.log('=====================');

console.log('');

if (!hasErrors && warnings.length === 0) {
  console.log('✅ All validations passed successfully!');
} else {
  if (warnings.length > 0) {
    console.log('⚠️ Warnings:');
    warnings.forEach((warning) => console.log(`  ${warning}`));
    console.log('');
  }
  if (hasErrors) {
    console.log('❌ Critical errors found. Please fix them before proceeding.');
  } else {
    console.log('✅ All validations passed successfully (with warnings).');
  }
}

process.exit(hasErrors ? 1 : 0);
