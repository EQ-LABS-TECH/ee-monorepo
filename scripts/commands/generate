#!/usr/bin/env node

import { spawnSync } from 'node:child_process';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';
import { Plop, run } from '../../node_modules/plop/src/plop.js';

const SCRIPT_DIR = dirname(fileURLToPath(import.meta.url));
const ROOT = process.cwd();
const PLOPFILE = join(ROOT, 'scripts', 'plopfile.mjs');
const PLOP_BIN = join(SCRIPT_DIR, '..', '..', 'node_modules', 'plop', 'bin', 'plop.js');

console.log('🔧 Code Generator');
console.log('=================');
console.log('');

if (!existsSync(PLOPFILE)) {
  console.error('❌ scripts/plopfile.mjs not found (EE-DOC-012 / EE-IMP-012-P05).');
  console.error('   Generation registry is required (No False Pass).');
  process.exit(1);
}

const plopCheck = spawnSync(process.execPath, [PLOP_BIN, '--version'], {
  stdio: 'pipe',
  encoding: 'utf8',
  cwd: ROOT,
});

if (plopCheck.error || plopCheck.status !== 0) {
  console.error('❌ Plop is not available. Please run: pnpm install');
  if (plopCheck.error) {
    console.error(plopCheck.error.message);
  }
  process.exit(1);
}

console.log(`  Plop: ${plopCheck.stdout.trim()}`);
console.log('  Registry: scripts/plopfile.mjs');
console.log('');
console.log('📦 Generating from templates...');
console.log('');

Plop.prepare(
  {
    cwd: ROOT,
    configPath: PLOPFILE,
  },
  (env) => {
    run(env, undefined, true).catch((error) => {
      console.error('❌ Failed to run generator:', error);
      process.exitCode = 1;
    });
  },
);
