#!/usr/bin/env node
import { mkdirSync } from 'node:fs';
import { join } from 'node:path';
import { runWorkspaceQualityGate } from '../lib/workspace-quality-gates.mjs';

// Redirect TEMP/TMP/TMPDIR locally to avoid Windows worker EPERM errors.
const localTmp = join(process.cwd(), '.tmp', 'vitest');
mkdirSync(localTmp, { recursive: true });
process.env.TMP = localTmp;
process.env.TEMP = localTmp;
process.env.TMPDIR = localTmp;

console.log('🧪 Running tests (QG-TEST-001)...');
console.log('');

const status = runWorkspaceQualityGate('test');
process.exit(status);
