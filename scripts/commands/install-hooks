#!/usr/bin/env node

import { spawnSync } from 'node:child_process';

const result = spawnSync('git', ['config', 'core.hooksPath', '.githooks'], {
  encoding: 'utf8',
  stdio: 'inherit',
});

if (result.error || result.status !== 0) {
  console.error('Could not configure the repository-local Git hooks path.');
  process.exit(1);
}

console.log('Git hooks installed from .githooks for this local clone.');
