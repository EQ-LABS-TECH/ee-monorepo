#!/usr/bin/env node

import { spawnSync } from "node:child_process";

console.log("🔍 Running linter...");
console.log("");

const result = spawnSync("turbo", ["run", "lint"], {
  stdio: "inherit",
  shell: true,
});

if (result.status !== 0) {
  console.error("");
  console.error("❌ Linting failed");
  process.exit(result.status ?? 1);
}

console.log("");
console.log("✅ Linting passed!");
